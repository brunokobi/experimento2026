# ============================================================
# Copie este arquivo para ".env" e ajuste os valores localmente.
# NUNCA faca commit do arquivo ".env" real (ver .gitignore).
# ============================================================

# --- Ambiente ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Caminhos de dados (relativos a raiz do projeto ou absolutos) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_GRAPH_EXPORTS_DIR=data/graph_exports

# --- Fonte de dados original (SQLite / Parquet) ---
SQLITE_DB_PATH=data/raw/empresas.db
PARQUET_DIR=data/raw

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- Parametros de memoria / performance para montagem da HIN ---
MAX_MEMORY_GB=8.0
NUM_WORKERS=4
RANDOM_SEED=42
TORCH_DEVICE=cpu
BATCH_SIZE=1024
